# Application role: no BYPASSRLS. Every query runs inside withTenant(), which sets app.agency_id.
DATABASE_URL=postgres://eightgency_app:eightgency_app@localhost:5432/eightgency
# Admin role: owns the schema, has BYPASSRLS. Used only for migrations, auth/session lookup and hub-token resolution.
DATABASE_ADMIN_URL=postgres://eightgency_admin:eightgency_admin@localhost:5432/eightgency
# Superuser connection used once by `npm run db:setup` to create the roles and database.
POSTGRES_SUPERUSER_URL=postgres://postgres:postgres@localhost:5432/postgres

APP_URL=http://localhost:3000
# Public site details (privacy policy, terms, footer). Set once the company exists.
SITE_DOMAIN=8gency.co.za
SITE_LEGAL_NAME=
SITE_REGISTRATION=
SITE_ADDRESS=
SITE_INFO_OFFICER=
# Leave unset at launch: Google Drive is held back (restricted scope).
GOOGLE_DRIVE_ENABLED=
UPLOAD_DIR=./uploads
# Shared secret for the inbound email / WhatsApp webhooks (/api/inbound/*).
INBOUND_WEBHOOK_SECRET=change-me

# Optional. When set, 8gent uses Claude for status-report and WIP drafts; otherwise it uses built-in templates.
ANTHROPIC_API_KEY=

# ── Connectors (/app/connectors) ─────────────────────────────────────────
# Encrypts connector tokens and API keys at rest. 32 random bytes, base64: openssl rand -base64 32
CONNECTOR_SECRET_KEY=
# The scheduler should POST /api/cron every 5–15 minutes with the x-8gency-secret header
# (INBOUND_WEBHOOK_SECRET): it runs automations, connector syncs and Outbox delivery.
#
# OAuth apps. Register each with this redirect URL: $APP_URL/api/connectors/oauth/callback
# A connector shows "not set up on this server" until its pair is filled in.
# Google Cloud (Gmail, Calendar, Drive, GA4, Google Ads): one OAuth client for all five.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: a manager (MCC) account ID if ad accounts sit under one.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Microsoft Entra (Outlook mail + calendar)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Intuit (QuickBooks Online). QUICKBOOKS_ENV=sandbox while testing.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox
# Meta for Developers (Meta Ads)
META_CLIENT_ID=
META_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# API versions providers retire on a schedule; bump without a code change.
# META_GRAPH_VERSION=v23.0
# GOOGLE_ADS_API_VERSION=v22
#
# WhatsApp Business, PayFast, Paystack and Stripe use keys each agency pastes on its connector page.

# ── Account email (password resets, team invites, waitlist invitations) ───
# 8gency's own email, never an agency's client email. Create a Resend account,
# verify your domain, then fill both in. Without them, outside production the
# messages are kept in the system_mail table; in production, sending fails.
RESEND_API_KEY=
SYSTEM_MAIL_FROM=8gency <hello@your-domain.example>
