{
  "name": "8gency",
  "version": "0.1.0",
  "private": true,
  "description": "The operating system for advertising and marketing agencies.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/db-setup.ts --reset && tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "invite": "tsx scripts/invite-agency.ts",
    "waitlist": "tsx scripts/waitlist.ts",
    "db:backup": "sh scripts/db-backup.sh",
    "db:restore-test": "sh scripts/db-restore-test.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
