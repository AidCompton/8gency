{
  "prerender": [
    {
      "where": {
        "and": [
          {
            "href_matches": "/app/*"
          },
          {
            "not": {
              "href_matches": [
                "/app/chat",
                "/app/chat/*"
              ]
            }
          },
          {
            "not": {
              "selector_matches": "[data-no-prerender]"
            }
          }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}